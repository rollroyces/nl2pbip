relationship "Sales_Date_Date_Date" {
  fromTable = "Sales"
  fromColumn = "Date"
  toTable = "Date"
  toColumn = "Date"
  cardinality = manyToOne
  crossFilterDirection = single
  isActive = true
}

table "Date" {
  columns = [
    column "Date" {
      dataType = date
      formatString = "yyyy-MM-dd"
    },
    column "Month" {
      dataType = string
    },
    column "Year" {
      dataType = wholeNumber
      formatString = "#,0"
    }
  ]
}

table "Sales" {
  columns = [
    column "SaleId" {
      dataType = string
    },
    column "Region" {
      dataType = string
    },
    column "Amount" {
      dataType = decimal
      formatString = "#,0.00"
    },
    column "Date" {
      dataType = date
      formatString = "yyyy-MM-dd"
    }
  ]
  measures = [
    measure "Total Revenue" {
      expression = '''
      SUM(Sales[Amount])
      '''
      formatString = "$#,0.00"
    }
  ]
}
