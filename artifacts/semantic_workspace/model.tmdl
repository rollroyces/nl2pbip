table "Date" {
  columns = [
    column "Date" {
      dataType = date
    }
    column "Month" {
      dataType = string
    }
    column "Year" {
      dataType = wholeNumber
    }
  ]
}

table "Sales" {
  columns = [
    column "SaleId" {
      dataType = string
    }
    column "Region" {
      dataType = string
    }
    column "Amount" {
      dataType = decimal
    }
    column "Date" {
      dataType = date
    }
  ]
  measures = [
    measure "Total Revenue" {
      expression = '''
SUM(Sales[Amount])
'''
      formatString = "$#,0.00"
    }
  ]
}

relationship "Sales_Date_Date_Date" {
  fromTable = "Sales"
  fromColumn = "Date"
  toTable = "Date"
  toColumn = "Date"
  cardinality = manyToOne
  crossFilterDirection = single
  isActive = true
}
