relationship "Sales_Date_Date_Date" {
  fromTable = "Sales"
  fromColumn = "Date"
  toTable = "Date"
  toColumn = "Date"
  cardinality = manyToOne
  crossFilterDirection = single
  isActive = true
}

table "Date" {
  columns = [
    column "Date" {
      dataType = date
      formatString = "yyyy-MM-dd"
    },
    column "Month" {
      dataType = string
    },
    column "Year" {
      dataType = wholeNumber
      formatString = "#,0"
    }
  ]
}

table "Sales" {
  partition "Sales" = mode: import, source: { type: m, expression = "let
    Source = let
    Source = Csv.Document(File.Contents(""raw/sales.csv""), [Delimiter="","", Encoding=65001, QuoteStyle=QuoteStyle.Csv])
in
    Source
    #""Sales"" = Table.PromoteHeaders(Source, [PromoteAllScalars=true])
    #""Changed Type"" = Table.TransformColumnTypes(#""Sales"", {{""SaleId"", text}, {""Region"", text}, {""Amount"", number}, {""Date"", date}})
in
    #""Changed Type""" }
  columns = [
    column "SaleId" {
      dataType = string
    },
    column "Region" {
      dataType = string
    },
    column "Amount" {
      dataType = decimal
      formatString = "#,0.00"
    },
    column "Date" {
      dataType = date
      formatString = "yyyy-MM-dd"
    }
  ]
  measures = [
    measure "Total Revenue" {
      expression = '''
      SUM(Sales[Amount])
      '''
      formatString = "$#,0.00"
    }
  ]
}

table 'CG Time Intelligence' {
    calculationGroup
        precedence: 10

        calculationItem 'Current' = '''
          SELECTEDMEASURE()
          '''
        calculationItem 'YTD' = '''
          CALCULATE(SELECTEDMEASURE(), DATESYTD('Date'[Date]))
          '''
        calculationItem 'Prior Year' = '''
          CALCULATE(SELECTEDMEASURE(), DATEADD('Date'[Date], -1, YEAR))
          '''
        calculationItem 'YoY %' = '''
          DIVIDE(SELECTEDMEASURE() - CALCULATE(SELECTEDMEASURE(), DATEADD('Date'[Date], -1, YEAR)), CALCULATE(SELECTEDMEASURE(), DATEADD('Date'[Date], -1, YEAR)))
          '''
        calculationItem 'YoY %' formatStringDefinition = '''
          VAR x = SELECTEDMEASUREFORMATSTRING() RETURN IF(ISNUMERIC(x), "0.00%", x)
          '''

  column "Name" {
    dataType = string
  }
  column "Ordinal" {
    dataType = wholeNumber
    formatString = "#,0"
  }
}

table "Metric Selection" {
  isParameterTable
  partition "Metric Selection" = calculated
  expression = '''
{
    ("Total Revenue", NAMEOF('Sales'[Total Revenue]), 0),
    ("Region", NAMEOF('Sales'[Region]), 1),
}
  '''
  columns = [
    column "Metric Selection" {
      dataType = string
      sourceColumn = "Metric Selection.[Value1]"
      sortByColumn = "Metric Selection Ordinal"
      isNameInferred
    },
    column "Metric Selection Fields" {
      dataType = string
      sourceColumn = "Metric Selection.[Value2]"
      isNameInferred
      isHidden
    },
    column "Metric Selection Ordinal" {
      dataType = int64
      formatString = "#,0"
      sourceColumn = "Metric Selection.[Value3]"
      isNameInferred
      isHidden
    }
  ]
}
